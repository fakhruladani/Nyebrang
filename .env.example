# Konfigurasi server Nyebrang! (semua opsional untuk development).
# `npm start` membaca file .env ini otomatis. Di VPS nilainya ada di /etc/nyebrang/nyebrang.env.

# Alamat server Node (jangan dibuka ke publik; taruh di belakang reverse proxy)
HOST=127.0.0.1
PORT=3100

# Origin publik + prefix path game. Dipakai untuk CSP connect-src yang hanya mengizinkan <origin><base>api/
PUBLIC_ORIGIN=http://127.0.0.1:3100
PUBLIC_BASE=/nyebrang/

# Lokasi database SQLite (default: ./server/data/game.db)
# DB_PATH=/var/lib/nyebrang/game.db

# Kunci HMAC token run. WAJIB di production: openssl rand -base64 32
RUN_TOKEN_SECRET=

# Token moderasi /api/admin/* (kosong = endpoint admin mati): openssl rand -hex 24
ADMIN_TOKEN=

# Lama waktu menulis nama setelah masuk Top 5 (ms)
# CLAIM_WINDOW_MS=120000
