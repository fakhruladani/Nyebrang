# Server Nyebrang!
HOST=127.0.0.1
PORT=3100
# Origin publik (dipakai untuk CSP connect-src yang dibatasi ke path API game)
PUBLIC_ORIGIN=https://72-62-122-35.sslip.io
# Prefix path publik (Caddy memakai handle_path, jadi server sendiri melayani di "/")
PUBLIC_BASE=/nyebrang/
# Lokasi database SQLite (dipakai mulai F3)
DB_PATH=/var/lib/nyebrang/game.db
# Kunci HMAC token run (F4): openssl rand -base64 32
RUN_TOKEN_SECRET=
